# ============================================
# Custom extensions to .bashrc
# ============================================

# History settings
shopt -s histverify
shopt -s histreedit

# Aliases for nvim
if command -v nvim >/dev/null 2>&1; then
    alias vim='nvim'
fi

# Set default editor to vim
export EDITOR=vi
export VISUAL=vim

# Alias to display all files with ll
alias ll='ls -la --color=auto'
